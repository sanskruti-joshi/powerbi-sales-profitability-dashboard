table Sheet1
	lineageTag: 1eaa62fc-0732-4c8a-b593-b4a1e6a9b85b

	measure 'Total Sales' = SUM(Sheet1[ Sales])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 9cfa5adf-5a40-44a3-ac2d-f8b1a3bcc471

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total Profit' = SUM(Sheet1[Profit])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: e91b3744-9649-4f83-975c-3ce849f1341f

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total Units Sold' = SUM(Sheet1[Units Sold])
		formatString: 0.00
		lineageTag: feaad759-6786-4a85-bcd3-d1936fb81e16

	measure 'Profit Margin' = DIVIDE([Total Profit],[Total Sales],0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a9d89e0e-9a45-49fc-ab69-07e382ee57cb

	measure 'Previous Year Sales' =
			
			CALCULATE(
			    [Total Sales],
			    SAMEPERIODLASTYEAR(DateTable[Date])
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 15b4a627-8cd3-4724-98d1-0d86e5320570

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'YoY Sales Growth %' =
			
			IF(
			    NOT ISINSCOPE(DateTable[Year])
			        || ISBLANK([Previous Year Sales]),
			    BLANK(),
			    DIVIDE(
			        [Total Sales] - [Previous Year Sales],
			        [Previous Year Sales]
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e90c0c94-dbe9-44a9-b701-97ef9140950d

